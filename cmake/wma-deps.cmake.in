#! Per-platform dependency lookups for one installed build of wma, included by
#! wmaConfig.cmake once it has resolved the caller's ABI tag. These cannot live
#! in wmaConfig.cmake itself: one prefix holds every platform, so a single
#! config would carry whichever build installed last -- a Linux consumer
#! silently skipping find_dependency(X11) because a wasm install came after it.

# ink is a PUBLIC dependency of wma and part of its link interface.
find_dependency(ink CONFIG)

if(@WMA_ENABLE_SDL@)
    find_dependency(SDL3 CONFIG COMPONENTS SDL3)
endif()

if(@WMA_ENABLE_GLFW@)
    find_dependency(glfw3)
endif()

# X11, Wayland, ALSA, EGL and xkbcommon are deliberately absent: wma binds them with dlopen() and only needs their
# headers to build, so a consumer links none of them (see src/platform/DynLib.hpp).
